{
  "manifest_version": 3,
  "name": "New Tab Organizer",
  "version": "0.2.0",
  "description": "Keyboard-first new tab page with bookmark organization and tools",
  "permissions": ["storage", "favicon"],
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
